# ─────────────────────────────────────────────────────────────────────────────
# Agentic Trading System — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# SECRETS (API keys, tokens) should live in ~/.openclaw/.env per TOOLS.md:
#   mkdir -p ~/.openclaw && cp .env.template ~/.openclaw/.env
#   # Then edit ~/.openclaw/.env with your real keys
#
# This workspace .env is for NON-SECRET configuration only (model slugs, etc).
# The system loads secrets from ~/.openclaw/.env at runtime.
#
# NEVER commit secrets to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── OpenRouter API (required) ──────────────────────────────────────────────
# Single key for all LLM calls (Claude + GPT-4o via OpenRouter)
# Get one at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ── Gmail (optional — for email delivery of recommendations) ───────────────
# Generate app password at: https://myaccount.google.com/apppasswords
# If not set, email delivery is skipped silently.
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
GMAIL_FROM=your-email@gmail.com

# ── FRED API (optional — for macro economic data) ─────────────────────────
# Free key at: https://fred.stlouisfed.org/docs/api/api_key.html
# If not set, macro data service uses cached/fallback values.
FRED_API_KEY=your-fred-key-here

# ── NewsAPI (optional — for headline scanning) ────────────────────────────
# Free tier at: https://newsapi.org/register
# If not set, news scanning is skipped.
NEWSAPI_KEY=your-newsapi-key-here
